{
  "name": "vsub-cli",
  "version": "1.12.0",
  "packageManager": "pnpm@12.18.0",
  "description": "CLI tool to extract audio, transcribe speech (ElevenLabs Scribe v2 via OpenRouter, or Groq Whisper), and generate translated subtitles, chapters and summaries with Gemini",
  "type": "module",
  "bin": {
    "vsub": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsx scripts/prepare-build.ts && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "fixtures:setup": "tsx scripts/setup-fixtures.ts",
    "watch:models": "tsx scripts/watch-models.ts",
    "build:licenses": "tsx scripts/generate-licenses.ts",
    "build:bundle": "tsx scripts/build-binary.ts --bundle-only",
    "build:binary": "tsx scripts/build-binary.ts",
    "package:release": "tsx scripts/package-release.ts",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "deps:semver": "pnpm up -r",
    "deps:latest": "pnpm up -r --latest",
    "deps:interactive": "pnpm up -r -i --latest",
    "update:node": "tsx scripts/check-node-update.ts",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "cli",
    "subtitles",
    "subtitle",
    "srt",
    "vtt",
    "whisper",
    "groq",
    "gemini",
    "translation",
    "transcription",
    "speech-to-text",
    "openrouter",
    "elevenlabs"
  ],
  "author": "koohq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koohq/vsub-cli.git"
  },
  "homepage": "https://github.com/koohq/vsub-cli#readme",
  "bugs": {
    "url": "https://github.com/koohq/vsub-cli/issues"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dependencies": {
    "@google/genai": "^3.1.0",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "execa": "^10.2.1",
    "groq-sdk": "^1.6.0",
    "ora": "^10.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tsconfig/node26": "^26.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
