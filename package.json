{
  "name": "vsub-cli",
  "version": "1.1.2",
  "packageManager": "pnpm@11.22.0",
  "description": "CLI tool to extract audio, transcribe speech with Groq Whisper, and translate subtitles using Google Gemini API",
  "type": "module",
  "bin": {
    "vsub": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "fixtures:setup": "tsx scripts/setup-fixtures.ts",
    "watch:models": "tsx scripts/watch-models.ts",
    "build:licenses": "tsx scripts/generate-licenses.ts",
    "build:bundle": "tsx scripts/build-binary.ts --bundle-only",
    "build:binary": "tsx scripts/build-binary.ts",
    "package:release": "tsx scripts/package-release.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "deps:semver": "pnpm up -r",
    "deps:latest": "pnpm up -r --latest",
    "deps:interactive": "pnpm up -r -i --latest",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "cli",
    "subtitles",
    "subtitle",
    "srt",
    "vtt",
    "whisper",
    "groq",
    "gemini",
    "translation",
    "transcription"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/koohq/vsub-cli.git"
  },
  "homepage": "https://github.com/koohq/vsub-cli#readme",
  "bugs": {
    "url": "https://github.com/koohq/vsub-cli/issues"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dependencies": {
    "@google/genai": "^2.18.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "execa": "^10.0.1",
    "groq-sdk": "^1.5.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tsconfig/node26": "^26.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
