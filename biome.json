{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!!dist",
      "!!coverage",
      "!!.worktrees",
      "!!scratch",
      "!!docs",
      "!src/licenses.data.ts"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
