# Groq API Key (https://console.groq.com/)
VSUB_GROQ_API_KEY=your_groq_api_key_here
# (フォールバック互換名: GROQ_API_KEY)

# Google Gemini API Key (https://aistudio.google.com/)
VSUB_GEMINI_API_KEY=your_gemini_api_key_here
# (フォールバック互換名: GEMINI_API_KEY)

# (Optional) Path to ffmpeg binary if not in system PATH
# VSUB_FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe

