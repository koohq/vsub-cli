# OpenRouter API Key for transcription and text generation (https://openrouter.ai/keys)
VSUB_OPENROUTER_API_KEY=

# Optional: Transcription provider selection ("openrouter" (default) or "groq")
# VSUB_STT_PROVIDER=groq

# Optional: Text generation provider selection ("gemini" (default if key exists) or "openrouter")
# VSUB_LLM_PROVIDER=openrouter

# Groq API Key (https://console.groq.com/)
GROQ_API_KEY=

# Optional: Gemini API Key (if provided, uses Gemini directly for translation, chapters and summaries) (https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: FFmpeg executable path (searched in PATH by default)
# VSUB_FFMPEG_PATH=ffmpeg
